# KVC Cowork — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to git

# ── Kimi 3 / Moonshot AI (Primary orchestrator) ──────────────
MOONSHOT_API_KEY=sk-your-moonshot-key-here

# ── Cloudflare (Edge AI + infrastructure) ────────────────────
CF_ACCOUNT_ID=9a3c0d0f1bc8bb5c83574905b6e13680
CF_API_TOKEN=your-cloudflare-api-token
CF_AI_API_TOKEN=your-cloudflare-ai-token

# ── OpenRouter (free tier multi-model gateway) ────────────────
OPENROUTER_API_KEY=your-openrouter-key

# ── NVIDIA NIM (high-perf inference) ─────────────────────────
NVIDIA_API_KEY=your-nvidia-nim-key

# ── Anthropic (Claude fallback) ───────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-key

# ── OpenAI (GPT fallback) ─────────────────────────────────────
OPENAI_API_KEY=your-openai-key

# ── GitHub (MCP server) ───────────────────────────────────────
GITHUB_PAT=your-github-personal-access-token

# ── GoHighLevel (CRM integration) ────────────────────────────
GHL_API_KEY=your-ghl-api-key
GHL_LOCATION_ID=your-ghl-location-id

# ── KVC Cowork App ────────────────────────────────────────────
VITE_APP_NAME=KVC Cowork
VITE_APP_URL=https://cowork.kalivibecoding.com
VITE_DEFAULT_PROVIDER=moonshot
VITE_DEFAULT_MODEL=moonshot-v1-128k
